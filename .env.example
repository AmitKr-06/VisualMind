# ============================================================
# VisualMind — Environment variables
# Copy this file to .env and fill in your own keys.
# NEVER commit the real .env file.
# ============================================================

# --- Google Gemini (primary LLM, vision) ---
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# --- Groq (fallback LLM, text only) ---
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# --- Groq model configuration ---
# Available as of 2026: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_ANSWER_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_REWRITE_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct